<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Episode counts: "1 Ep" / "12 Eps" -->
    <plurals name="episodes_count">
        <item quantity="one">%d Ep</item>
        <item quantity="other">%d Eps</item>
    </plurals>

    <!-- Chapter counts: "1 Ch" / "10 Ch" -->
    <plurals name="chapters_count">
        <item quantity="one">%d Kap</item>
        <item quantity="other">%d Kap</item>
    </plurals>

    <!-- Episodes behind: "1 EP BEHIND" / "3 EPS BEHIND" -->
    <plurals name="episodes_behind">
        <item quantity="one">%d EP IM RÜCKSTAND</item>
        <item quantity="other">%d EPS IM RÜCKSTAND</item>
    </plurals>

    <!-- Time formatting - days -->
    <plurals name="time_days">
        <item quantity="one">%dT</item>
        <item quantity="other">%dT</item>
    </plurals>

    <!-- Time formatting - hours -->
    <plurals name="time_hours">
        <item quantity="one">%dStd</item>
        <item quantity="other">%dStd</item>
    </plurals>

    <!-- Time formatting - minutes -->
    <plurals name="time_minutes">
        <item quantity="one">%dMin</item>
        <item quantity="other">%dMin</item>
    </plurals>

    <!-- Plurals for episodes/chapters -->
    <plurals name="toast_more_fields">
        <item quantity="one">%1$d weiteres Feld</item>
        <item quantity="other">%1$d weitere Felder</item>
    </plurals>
    <!-- A progress unit after a number; the number is printed separately. -->
    <plurals name="unit_episodes">
        <item quantity="one">Episode</item>
        <item quantity="other">Episoden</item>
    </plurals>
    <!-- A progress unit after a number; the number is printed separately. -->
    <plurals name="unit_chapters">
        <item quantity="one">Kapitel</item>
        <item quantity="other">Kapitel</item>
    </plurals>
    <!-- A progress unit after a number; the number is printed separately. -->
    <plurals name="unit_pages">
        <item quantity="one">Seite</item>
        <item quantity="other">Seiten</item>
    </plurals>
    <!-- A progress unit after a number; the number is printed separately. -->
    <plurals name="unit_issues">
        <item quantity="one">Ausgabe</item>
        <item quantity="other">Ausgaben</item>
    </plurals>
    <!-- A progress unit after a number; the number is printed separately. -->
    <plurals name="unit_plays">
        <item quantity="one">Partie</item>
        <item quantity="other">Partien</item>
    </plurals>
</resources>
